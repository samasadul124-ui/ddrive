# DDrive configuration. Every value is optional except the ones you need for
# the storage backend you pick: with nothing set, DDrive runs on embedded
# SQLite + local disk (see README.md). Lines starting with "#" are comments;
# inline "//" comments are kept for readability of the template.
#
# For a Discord-backed deployment the only required lines are:
#   STORAGE_DRIVER=discord
#   WEBHOOKS=<one or more webhook urls>

# ----------------------------------------------------------------- storage ---
STORAGE_DRIVER=local                 # local | discord | s3 | memory (tests only)
WEBHOOKS=                            # discord only: ',' separated webhook urls
CHUNK_SIZE=10420224                  # 10 MiB minus multipart/encryption overhead.
                                     # 10485760 (10 MiB) is the largest request a
                                     # Discord webhook accepts, so a bigger chunk
                                     # is rejected with HTTP 413. DDrive clamps
                                     # oversized values and tells you at boot.
UPLOAD_CONCURRENCY=3                 # chunks uploaded in parallel
DISCORD_API_BASE=                    # override https://discord.com/api (proxies, tests)
STORAGE_DIRECTORY=                   # local backend: where chunks are written
DATA_DIR=                            # runtime state (sqlite file, default buckets)
                                     # raising/lowering CHUNK_SIZE never invalidates
                                     # stored objects: downloads read the chunk size
                                     # each version was written with.

# ------------------------------------------------------------------ database --
# Leave DB_DRIVER/DATABASE_URL empty for embedded SQLite.
DB_DRIVER=                           # sqlite | postgres (auto-detected from DATABASE_URL)
DATABASE_URL=                        # postgres://user:pass@host:5432/ddrive
SQLITE_FILE=                         # sqlite backend: database file path

# ------------------------------------------------------------------- server ---
PORT=3000                            # HTTP port
HOST=0.0.0.0
REQUEST_TIMEOUT=60000                # abort Discord requests after this many ms
WEBDAV_PATH=/webdav                  # mountable Class 1/2/3 WebDAV endpoint
S3_PATH=/s3                          # S3 API (SigV4)
REST_PATH=/api                       # JSON API used by the console

# ----------------------------------------------------------------- security ---
AUTH_MODE=none                       # none (default) = no login, no password, anyone
                                     # who can reach the port has full access. Set to
                                     # "basic" to require credentials.
BOOTSTRAP_ADMIN_USER=admin           # account used when AUTH_MODE=none (owning objects,
                                     # audit trail) and the login name when basic
BOOTSTRAP_ADMIN_PASSWORD=            # only needed with AUTH_MODE=basic. Policy: 8+ chars,
                                     # upper + lower + digit, must not contain the username
AUTH=                                # legacy user:password - setting it implies basic
                                     # auth, which is why the sample leaves it empty
MASTER_KEY=                          # 32-byte hex; encrypts object bytes at rest.
                                     # Required in production. MASTER_KEY_FILE also works.
                                     # NOTE: this is not a login - it protects stored data,
                                     # not access to the server.
PUBLIC_ACCESS=                       # READ_ONLY_FILE | READ_ONLY_PANEL | empty
SECRET=                              # legacy v2/v3 decryption key (only for old data)

# ---------------------------------------------------------------- lifecycle ---
DEFAULT_BUCKET=ddrive
NODE_NAME=                           # node identity for replication (default: hostname)
NODE_REGION=                         # region reported by this node
LOG_LEVEL=                           # trace | debug | info | warn | error
